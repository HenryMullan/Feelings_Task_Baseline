        <Param val=" let theseKeys = psychoJS.eventManager.getKeys({keyList: ['a', 'b', 'c', 'd','e','f','g','h','i','j','k','l','m','n','o','p','q','r','s','t','u','v','w','x','y','z','backspace']});&amp;#10;    if (theseKeys.length &gt; 0) {  // at least one key was pressed&amp;#10;      textAdd = theseKeys[theseKeys.length-1]; &amp;#10;      }&amp;#10;    if (textAdd === 'minus') {&amp;#10;        textAdd = '-';  // Add a space&amp;#10;    } else if (textAdd === 'backspace') {&amp;#10;        word2.text = word2.text.slice(0, -1);&amp;#10;        textAdd = undefined;&amp;#10;    } else if (textAdd !== undefined) {&amp;#10;        word2.text = word2.text + textAdd;&amp;#10;        textAdd = undefined;&amp;#10;    }&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
